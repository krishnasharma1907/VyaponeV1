# VyapOne Environment Variables Configuration Template
# Copy this file to .env.local for local development. Never commit .env or secrets to Git.

# Application Configuration
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authentication (Supabase / NextAuth)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=development-only-secret-replace-in-production-min-32-chars

# Database (PostgreSQL with RLS)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vyapone_dev
DATABASE_DIRECT_URL=postgresql://postgres:postgres@localhost:5432/vyapone_dev

# Cache and Queues (Redis / BullMQ)
REDIS_URL=redis://localhost:6379

# Storage (S3 / Cloudflare R2 / Supabase Storage)
STORAGE_ENDPOINT=
STORAGE_BUCKET=vyapone-media-dev
STORAGE_REGION=ap-south-1
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Payment Gateway (Razorpay Sandbox)
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder_secret
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

# WhatsApp Business Platform (Cloud API via BSP Sandbox)
META_WHATSAPP_TOKEN=placeholder_token
META_WHATSAPP_PHONE_NUMBER_ID=placeholder_phone_id
META_WHATSAPP_BUSINESS_ACCOUNT_ID=placeholder_waba_id
META_WEBHOOK_VERIFY_TOKEN=placeholder_verify_token

# AI Gateway (Anthropic & Google Cloud)
ANTHROPIC_API_KEY=placeholder_anthropic_key
GEMINI_API_KEY=placeholder_gemini_key
