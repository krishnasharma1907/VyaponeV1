# ==============================================================================
# VyapOne Environment Variables Configuration Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to `.env.local` for local development:
#      cp .env.example .env.local
# 2. Never commit `.env.local`, `.env`, or any real secrets to Git.
# 3. For Cloudflare deployments:
#    - Use `.dev.vars` for local `wrangler pages dev` testing.
#    - Set secrets in the Cloudflare Dashboard under Settings > Variables and Secrets.
#    - Non-secret variables can also be placed under [vars] in wrangler.toml.
# ==============================================================================

# ==============================================================================
# 1. PUBLIC CONFIGURATION (Safe for Browser & Client Components)
# ==============================================================================
# These variables are bundled into client-side JavaScript.
# NEVER place private database passwords or service-role keys here.

# Runtime environment (development | preview | staging | production | test)
NEXT_PUBLIC_APP_ENV=development

# Canonical application URL (used for redirects, metadata, and absolute URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Public Project URL (https://<project-ref>.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://placeholder-project-ref.supabase.co

# Supabase Public Anonymous API Key (safe for browser with PostgreSQL RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-supabase-anon-key-jwt-format-here

# ==============================================================================
# 2. SERVER-ONLY CORE CONFIGURATION (Privileged — Never Exposed to Client)
# ==============================================================================
# Guarded by `import "server-only"`. Required for production server operation.

# Platform Node environment (development | production | test)
NODE_ENV=development

# Local development port
PORT=3000

# Session encryption secret (MUST be at least 32 characters in production)
SESSION_SECRET=development-only-session-secret-min-32-chars-long

# PostgreSQL Connection String (Supabase pooler or local PostgreSQL with RLS)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vyapone_dev

# Direct PostgreSQL Connection String (for schema migrations and non-pooled DDL)
DATABASE_DIRECT_URL=postgresql://postgres:postgres@localhost:5432/vyapone_dev

# Supabase Service Role Key (PRIVILEGED — Bypasses RLS, server-side only)
SUPABASE_SERVICE_ROLE_KEY=placeholder-supabase-service-role-key-min-32-chars

# ==============================================================================
# 3. OPTIONAL THIRD-PARTY INTEGRATIONS (Server-Side Only)
# ==============================================================================
# The application runs locally without these credentials.
# Features dependent on them will report `isConfigured: false` safely.

# Cache and Background Queues (Redis / Upstash / BullMQ)
REDIS_URL=redis://localhost:6379

# Object Storage (Cloudflare R2 / AWS S3 / Supabase Storage)
STORAGE_ENDPOINT=https://placeholder-account-id.r2.cloudflarestorage.com
STORAGE_BUCKET=vyapone-media-dev
STORAGE_REGION=ap-south-1
STORAGE_ACCESS_KEY_ID=placeholder_r2_access_key_id
STORAGE_SECRET_ACCESS_KEY=placeholder_r2_secret_access_key

# Payment Gateway (Razorpay Sandbox)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=placeholder_razorpay_webhook_secret

# WhatsApp Business Platform (Meta Cloud API via BSP)
META_WHATSAPP_TOKEN=placeholder_whatsapp_system_user_token
META_WHATSAPP_PHONE_NUMBER_ID=placeholder_phone_number_id
META_WHATSAPP_BUSINESS_ACCOUNT_ID=placeholder_waba_account_id
META_WEBHOOK_VERIFY_TOKEN=placeholder_webhook_verify_token

# AI Gateway (Anthropic Claude & Google Gemini)
ANTHROPIC_API_KEY=placeholder_anthropic_api_key
GEMINI_API_KEY=placeholder_gemini_api_key
