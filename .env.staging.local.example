# ==============================================================================
# VyapOne Staging Environment Configuration Template (ISOLATED STAGING ONLY)
# ==============================================================================
# SAFETY INVARIANTS:
# 1. Copy this file to `.env.staging.local` for local staging runs:
#      cp .env.staging.local.example .env.staging.local
# 2. NEVER place production credentials, tokens, or project refs (`fjoezwoyowihbxacmoyp`) here.
# 3. NEVER commit `.env.staging.local` or any real staging secret to Git.
# 4. Run staging using the dedicated isolated runner scripts:
#      pnpm staging:check
#      pnpm dev:staging
#      pnpm build:staging
#      pnpm start:staging
#    These scripts do NOT fall back to `.env` and fail closed on any production target.
# ==============================================================================

# ==============================================================================
# 0. STAGING ISOLATION GUARD METADATA (Server-Only)
# ==============================================================================
# Set to the project ref of your dedicated VyapOne-Staging Supabase project.
# Runtime startup guards verify URLs, database DSNs, and JWT `ref` claims against this
# value and refuse startup if the production ref (`fjoezwoyowihbxacmoyp`) appears anywhere.
VYAPONE_STAGING_PROJECT_REF=placeholder-staging-project-ref

# ==============================================================================
# 1. PUBLIC CONFIGURATION (Safe for Browser & Client Components)
# ==============================================================================
# These four NEXT_PUBLIC_* keys are the ONLY environment variables exposed to
# client-side bundles via `src/config/public.ts`.

# Must remain `staging` for all staging runs
NEXT_PUBLIC_APP_ENV=staging

# Canonical staging origin URL (must NEVER point to vyapone.in or *.workers.dev prod)
# Local staging testing: http://localhost:3000
# Dedicated preview Worker (when authorized): https://vyapone-staging.<account>.workers.dev
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Dedicated VyapOne-Staging Supabase project URL (https://<staging-ref>.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://placeholder-staging-project-ref.supabase.co

# Dedicated VyapOne-Staging Supabase public anonymous key (JWT or sb_publishable_* key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-staging-supabase-anon-key-replace-me

# ==============================================================================
# 2. SERVER-ONLY CORE CONFIGURATION (Privileged — Never Exposed to Client)
# ==============================================================================
# Note: `pnpm dev:staging` runs with NODE_ENV=development and `pnpm build:staging` /
# `pnpm start:staging` run with NODE_ENV=production automatically via scripts/run-staging.mjs.
NODE_ENV=development
PORT=3000

# Unique random secret (minimum 32 characters) scoped ONLY to staging sessions
SESSION_SECRET=staging-only-session-secret-replace-before-running-min-32-chars

# Dedicated VyapOne-Staging PostgreSQL connection pooler URL (port 6543 / 5432)
DATABASE_URL=postgresql://postgres.placeholder-staging-project-ref:placeholder-staging-db-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Dedicated VyapOne-Staging direct PostgreSQL connection URL (migrations & pgTAP/DDL)
DATABASE_DIRECT_URL=postgresql://postgres:placeholder-staging-db-password@db.placeholder-staging-project-ref.supabase.co:5432/postgres

# Dedicated VyapOne-Staging Supabase service role key (PRIVILEGED — Bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=placeholder-staging-service-role-key-replace-me

# ==============================================================================
# 3. OPTIONAL STAGING BOOTSTRAP & THIRD-PARTY INTEGRATIONS (Sandbox / Test Only)
# ==============================================================================
# Features without integration keys will safely report `isConfigured: false`.
# Canonical Supabase Storage buckets (verify/create both on VyapOne-Staging):
#   - `vyapone-public-media` (public = true)
#   - `vyapone-private-media` (public = false)

# Staging Cache / Redis (leave blank or point to an isolated staging Redis)
REDIS_URL=

# Object Storage (optional S3/R2 facade override; Supabase Storage adapters use canonical buckets)
STORAGE_ENDPOINT=
STORAGE_BUCKET=vyapone-public-media
STORAGE_REGION=ap-south-1
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Razorpay Sandbox Test Keys ONLY (NEVER live rzp_live_* keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# WhatsApp Sandbox / Staging Test Credentials ONLY (NEVER production WABA)
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_WEBHOOK_VERIFY_TOKEN=

# AI Gateway Keys (Staging test quota keys ONLY)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
